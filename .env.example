# Настройки подключения к материнскому серверу Marzban
MARZBAN_URL=https://marzban.example.com
MARZBAN_ADMIN_USER=admin
MARZBAN_ADMIN_PASS=secret

# Интервал опроса нод (секунды)
POLL_INTERVAL=5

# Порт приложения
APP_PORT=8023

# Путь к SQLite для сохранения настроек из UI
SETTINGS_DB_PATH=/data/settings.db

# Авторизация веб-интерфейса
UI_LOGIN=admin
UI_PASSWORD=change_me

# Порт, на котором запущен локальный ip_agent (микросервис) на нодах.
# Если у ноды не указан api_port в master API, будет использован этот порт.
IP_AGENT_PORT=8001

# Адрес nginx proxy для Telegram API (опционально).
# Если задан, backend использует его вместо https://api.telegram.org
TELEGRAM_PROXY_URL=

# Telegram уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Минимальный интервал между уведомлениями (в секундах)
TELEGRAM_MIN_INTERVAL=300
